              "H5"
            ],
            "x-ui": {
              "widget": "radio-group",
              "options": [
                {
                  "label": "PC",
                  "value": "PC"
                },
                {
                  "label": "H5",
                  "value": "H5"
                }
              ]
            }
          }
        },
        "required": [
          "labelPosition",
          "labelWidth",
          "size",
          "layoutType"
        ],
        "additionalProperties": false
      },
      "pageOptions": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "pageNode": {
        "type": "object",
        "properties": {
          "type": {
            "const": "page"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "$ref": "#/$defs/pageOptions"
          },
          "widgetList": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/pageNode"
                },
                {
                  "$ref": "#/$defs/question-groupNode"
                },
                {
                  "$ref": "#/$defs/stemNode"
