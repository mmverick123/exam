  "questionJsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://exam.local/contracts/question-json/1.0.0",
    "type": "object",
    "properties": {
      "contractVersion": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      },
      "widgetList": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "$ref": "#/$defs/pageNode"
        }
